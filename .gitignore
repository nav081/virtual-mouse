# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build output
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example

# IDE and operating-system files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.code-workspace
.DS_Store
Thumbs.db

# Generated screenshots; keep the directory in the repository
screenshots/*
!screenshots/.gitkeep
